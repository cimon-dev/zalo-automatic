PORT=4000
FRONTEND_URL=http://localhost:3000

# Google Gemini API Key (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Trình duyệt Playwright (false: hiện cửa sổ trình duyệt để quan sát, true: chạy ngầm)
HEADLESS=false
STORAGE_STATE_PATH=./storage/session.json
PERSONA_PATH=./storage/persona_context.json
